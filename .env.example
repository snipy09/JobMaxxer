# ─────────────────────────────────────────────────────────────────────────────
# Job Automator — Environment Variables
# Copy this file to `.env` and fill in your values before running the app.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase Cloud Backend ────────────────────────────────────────────────────
# Required ONLY for the cloud job feed ("Get Cloud Feed" button) and
# Single-IP session heartbeat. Leave blank to use local scrapers only.
#
# Find these in: https://supabase.com → your project → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────
# All other secrets (Groq API key, SMTP password) are stored securely in the
# local SQLite database via the desktop app's "Master Profile" settings panel.
# No other environment variables are required.
# ─────────────────────────────────────────────────────────────────────────────