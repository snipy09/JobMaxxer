{
    "name":  "@job-automator/desktop",
    "version":  "1.0.0",
    "main":  "out/main/index.js",
    "type":  "module",
    "scripts":  {
                    "dev":  "concurrently \"vite\" \"wait-on http://localhost:5173 \u0026\u0026 cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron --disable-gpu .\"",
                    "vite:dev":  "vite",
                    "electron:dev":  "wait-on http://localhost:5173 \u0026\u0026 cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron --disable-gpu .",
                    "start":  "electron --disable-gpu .",
                    "build":  "tsc \u0026\u0026 vite build \u0026\u0026 electron-builder"
                },
    "build":  {
                  "appId":  "com.jobautomator.desktop",
                  "productName":  "Job Automator",
                  "directories":  {
                                      "output":  "dist-electron"
                                  },
                  "files":  [
                                "out/**/*",
                                "node_modules/**/*"
                            ],
                  "win":  {
                              "target":  "nsis"
                          },
                  "mac":  {
                              "target":  "dmg",
                              "hardenedRuntime":  true,
                              "gatekeeperAssess":  false,
                              "entitlements":  "build-resources/entitlements.mac.plist",
                              "entitlementsInherit":  "build-resources/entitlements.mac.plist"
                          },
                  "linux":  {
                                "target":  "AppImage"
                            }
              },
    "dependencies":  {
                         "@job-automator/automation":  "file:../../packages/automation",
                         "@job-automator/email-verifier":  "file:../../packages/email-verifier",
                         "@job-automator/scrapers":  "file:../../packages/scrapers",
                         "@job-automator/supabase":  "file:../../packages/supabase",
                         "lucide-react":  "^0.330.0",
                         "react":  "^18.2.0",
                         "react-dom":  "^18.2.0",
                         "sql.js":  "^1.10.3"
                     },
    "devDependencies":  {
                            "@types/node":  "^20.11.0",
                            "@types/react":  "^18.2.55",
                            "@types/react-dom":  "^18.2.19",
                            "@types/sql.js":  "^1.4.9",
                            "@vitejs/plugin-react":  "^4.2.1",
                            "autoprefixer":  "^10.4.17",
                            "concurrently":  "^8.2.2",
                            "cross-env":  "^7.0.3",
                            "electron":  "^28.2.0",
                            "electron-builder":  "^24.9.1",
                            "postcss":  "^8.4.35",
                            "tailwindcss":  "^3.4.1",
                            "typescript":  "^5.3.3",
                            "vite":  "^5.1.0",
                            "wait-on":  "^7.2.0"
                        }
}
