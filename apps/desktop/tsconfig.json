{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "out",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "types": ["node", "react", "react-dom"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out"]
}