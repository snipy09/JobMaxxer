{
  "name": "@nomadic/desktop",
  "version": "1.0.0",
  "description": "Nomadic — Desktop Job Search & Application Automation Platform",
  "author": "Nomadic",
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node build-main.mjs --watch\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron --disable-gpu .\"",
    "vite:dev": "vite",
    "electron:dev": "wait-on http://localhost:5173 && node build-main.mjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron --disable-gpu .",
    "start": "electron --disable-gpu .",
    "compile": "node build-main.mjs && vite build",
    "build": "node build-main.mjs && vite build",
    "package:win": "node build-main.mjs && vite build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.nomadic.career.os",
    "productName": "Nomadic",
    "electronVersion": "31.7.7",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Nomadic",
      "artifactName": "Nomadic Setup ${version}.exe",
      "uninstallDisplayName": "Nomadic ${version}"
    },
    "portable": {
      "artifactName": "Nomadic ${version}.exe",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "target": "dmg",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@job-automator/automation": "file:../../packages/automation",
    "@job-automator/email-verifier": "file:../../packages/email-verifier",
    "@job-automator/scrapers": "file:../../packages/scrapers",
    "@job-automator/supabase": "file:../../packages/supabase",
    "animejs": "^4.5.0",
    "lucide-react": "^0.330.0",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  }
}
